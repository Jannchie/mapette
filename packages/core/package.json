{
  "name": "@mapette/core",
  "version": "0.1.0",
  "description": "Framework-agnostic map UI on MapLibre for place-and-photo sites: Apple Maps–like basemap, cluster bubbles, photo pins, popovers, a side panel / bottom sheet, theme and locale helpers.",
  "type": "module",
  "license": "MIT",
  "author": "Jianqi Pan <jannchie@gmail.com>",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mapette.css": "./dist/mapette.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('src/mapette.css','dist/mapette.css')\"",
    "dev": "vite build --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "maplibre-gl": "^5.9.0",
    "pmtiles": "^4.5.0"
  },
  "peerDependenciesMeta": {
    "pmtiles": {
      "optional": true
    }
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@types/geojson": "^7946.0.16"
  },
  "keywords": [
    "map",
    "maplibre",
    "maplibre-gl",
    "photo",
    "pilgrimage",
    "cluster",
    "bottom-sheet",
    "popover"
  ],
  "publishConfig": {
    "access": "public"
  }
}
