{
  "name": "@mapette/vue",
  "version": "0.1.5",
  "description": "Vue 3 components for @mapette/core: MapView, MapExplorer (full-screen map with side panel / bottom sheet), MapFooter, photo pins and popovers.",
  "type": "module",
  "license": "MIT",
  "author": "Jianqi Pan <jannchie@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jannchie/mapette.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/Jannchie/mapette/tree/main/packages/vue#readme",
  "bugs": "https://github.com/Jannchie/mapette/issues",
  "files": [
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "sideEffects": [
    "**/*.css",
    "./src/index.ts"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.json",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mapette/core": "workspace:^"
  },
  "peerDependencies": {
    "maplibre-gl": "^5.9.0",
    "vue": "^3.5.0"
  },
  "keywords": [
    "map",
    "maplibre",
    "maplibre-gl",
    "vue",
    "photo",
    "pilgrimage",
    "cluster",
    "bottom-sheet",
    "popover"
  ],
  "publishConfig": {
    "access": "public"
  }
}
